#!/bin/sh

# Pre-push hook: проверка измененных файлов линтером перед пушем
# Если проверка не пройдет, пуш будет отменен

echo "🔍 Запуск проверки измененных файлов перед пушем..."

# Переходим в корень репозитория
cd "$(git rev-parse --show-toplevel)" || exit 1

# Получаем список измененных файлов (staged и unstaged)
CHANGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(js|ts|vue|scss|css)$' || true)
UNSTAGED_FILES=$(git diff --name-only --diff-filter=ACM | grep -E '\.(js|ts|vue|scss|css)$' || true)

# Объединяем списки, убираем дубликаты и пустые строки
ALL_FILES=$(echo "$CHANGED_FILES" "$UNSTAGED_FILES" | tr ' ' '\n' | grep -v '^$' | sort -u | tr '\n' ' ')
# Убираем пробелы по краям (чтобы при пустом списке не передавать пробел в xargs)
ALL_FILES=$(echo "$ALL_FILES" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

if [ -z "$ALL_FILES" ]; then
  echo "✅ Нет измененных файлов для проверки."
  exit 0
fi

echo "📝 Проверяемые файлы:"
echo "$ALL_FILES" | tr ' ' '\n' | sed 's/^/  - /'

# Проверяем JavaScript/TypeScript/Vue файлы
JS_FILES=$(echo "$ALL_FILES" | tr ' ' '\n' | grep -E '\.(js|ts|vue)$' || true)
if [ -n "$JS_FILES" ]; then
  echo ""
  echo "🔍 Проверка ESLint..."
  echo "$JS_FILES" | xargs npx eslint
  
  if [ $? -ne 0 ]; then
    echo ""
    echo "❌ Ошибки ESLint обнаружены!"
    echo "Попытка автоматического исправления..."
    echo "$JS_FILES" | xargs npx eslint --fix
    
    # Проверяем снова после исправления
    echo "$JS_FILES" | xargs npx eslint
    if [ $? -ne 0 ]; then
      echo ""
      echo "❌ Ошибки ESLint не удалось исправить автоматически!"
      echo "Пожалуйста, исправьте ошибки вручную перед пушем."
      echo "Для проверки запустите: npm run lint"
      exit 1
    fi
    
    echo "✅ Ошибки ESLint исправлены автоматически."
  else
    echo "✅ ESLint проверка пройдена успешно!"
  fi
fi

# Проверяем CSS/SCSS файлы
CSS_FILES=$(echo "$ALL_FILES" | tr ' ' '\n' | grep -E '\.(css|scss)$' || true)
if [ -n "$CSS_FILES" ]; then
  echo ""
  echo "🔍 Проверка Stylelint..."
  echo "$CSS_FILES" | xargs npx stylelint
  
  if [ $? -ne 0 ]; then
    echo ""
    echo "❌ Ошибки Stylelint обнаружены!"
    echo "Попытка автоматического исправления..."
    echo "$CSS_FILES" | xargs npx stylelint --fix
    
    # Проверяем снова после исправления
    echo "$CSS_FILES" | xargs npx stylelint
    if [ $? -ne 0 ]; then
      echo ""
      echo "❌ Ошибки Stylelint не удалось исправить автоматически!"
      echo "Пожалуйста, исправьте ошибки вручную перед пушем."
      echo "Для проверки запустите: npm run stylelint"
      exit 1
    fi
    
    echo "✅ Ошибки Stylelint исправлены автоматически."
  else
    echo "✅ Stylelint проверка пройдена успешно!"
  fi
fi

# Форматируем файлы с помощью Prettier (только если есть файлы — иначе Prettier выдаст ошибку)
echo ""
PRETTIER_FILES=$(echo "$ALL_FILES" | tr ' ' '\n' | grep -v '^$')
if [ -n "$PRETTIER_FILES" ]; then
  echo "🎨 Форматирование файлов с помощью Prettier..."
  echo "$PRETTIER_FILES" | xargs npx prettier --write
fi

echo ""
echo "✅ Все проверки пройдены успешно!"
exit 0
